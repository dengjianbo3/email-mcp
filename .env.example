# ===== email-mcp 环境变量配置（优先级：环境变量 > ~/.email-mcp/config.json > 默认值）=====

# 配置目录（默认 ~/.email-mcp）
# EMAIL_MCP_HOME=/path/to/dir

# 日志级别: debug | info | warn | error（默认 info）
# EMAIL_MCP_LOG=info

# ---- Gmail ----
# 从 Google Cloud Console 下载的 client_secret_*.json 中复制（见 docs/01-google-gmail-oauth-setup.md）
EMAIL_MCP_GMAIL_CLIENT_ID=
EMAIL_MCP_GMAIL_CLIENT_SECRET=
# 权限范围（空格分隔），默认: gmail.modify gmail.labels gmail.compose
# EMAIL_MCP_GMAIL_SCOPES="gmail.modify gmail.labels gmail.compose"
# 本地回调端口（默认 8787）
# EMAIL_MCP_GMAIL_CALLBACK_PORT=8787

# ---- Outlook ----
# 从 Entra 应用注册页复制 Application (client) ID（见 docs/02-microsoft-outlook-setup.md）
EMAIL_MCP_OUTLOOK_CLIENT_ID=
# 租户: common（个人账号默认）或你的 Directory (tenant) ID
# EMAIL_MCP_OUTLOOK_TENANT=common
# 权限范围（空格分隔），默认: Mail.ReadWrite Mail.Send User.Read offline_access
# EMAIL_MCP_OUTLOOK_SCOPES="Mail.ReadWrite Mail.Send User.Read offline_access"
