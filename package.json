{
  "name": "email-mcp",
  "version": "0.1.0",
  "description": "Gmail + Outlook 邮件 MCP 服务（自建，首次启动引导用户自行填入凭据）",
  "private": true,
  "type": "module",
  "bin": {
    "email-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.mjs\"",
    "smoke": "npm run build && node scripts/smoke-core.mjs && node scripts/smoke-setup.mjs && node scripts/smoke-m1.mjs && node scripts/smoke-m2.mjs && node scripts/smoke-m3.mjs && node scripts/smoke-http.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^13.1.0",
    "express": "^5.2.1",
    "prompts": "^2.4.2",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
